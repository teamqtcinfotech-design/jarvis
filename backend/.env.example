# Copy to .env and fill in. Never commit .env.

# --- Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=*

# --- Encryption key for MD private tasks (generate once; losing it makes private tasks unreadable)
FIELD_ENCRYPTION_KEY=

# --- Database: set DB_PASSWORD to use local PostgreSQL (database "jarvis"), otherwise SQLite is used
DB_NAME=jarvis
DB_USER=jarvis
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- AI brain (Claude)
ANTHROPIC_API_KEY=
JARVIS_AI_COMMAND_MODEL=claude-haiku-5-5
JARVIS_AI_BRIEFING_MODEL=claude-sonnet-5-5

# --- TaskPanel (the live staff panel at public_html/taskPanel)
# mock = built-in test double; live = the 3 Nov integration door (/taskPanel/integration/v1);
# gateway = the real TaskPanel's api.php (contract v1, 23 Nov 2026): one token acting as the MD's TaskPanel account.
TASKPANEL_MODE=mock
TASKPANEL_BASE_URL=
# live mode
TASKPANEL_KEY_ID=
TASKPANEL_SIGNING_SECRET=
TASKPANEL_ENV=production
TASKPANEL_EXPECTED_INSTANCE=
# gateway mode: TASKPANEL_BASE_URL=https://<host>/taskPanel/api.php, the token and the shared signing secret (both
# from the TaskPanel admin, by password manager), the TaskPanel user_key the token acts as, and the logins that are
# not people (test and company logins), hidden from every list and never given work.
TASKPANEL_API_TOKEN=
TASKPANEL_API_SECRET=
TASKPANEL_EXPECTED_ACTOR=
TASKPANEL_HIDE_KEYS=
# Writes default to ON in mock mode and OFF in live / gateway mode. Set true only for the pilot, and only once the
# TaskPanel side has tasks:create on the token.
# TASKPANEL_WRITES_ENABLED=false
# Default category for staff work: "other" in gateway mode (the only one that can go to anyone), else general.
# TASKPANEL_DEFAULT_CATEGORY=other

# Walkie-talkie relay (manage.py walkie_server). Laptop: ws://localhost:8001/ws/walkie/ (through adb reverse);
# live: the same host as the API under /ws/walkie/ (nginx passes /ws/ to the relay on JARVIS_WALKIE_PORT).
JARVIS_WALKIE_PORT=8001
JARVIS_WALKIE_URL=
