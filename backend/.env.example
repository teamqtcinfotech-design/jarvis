# Copy to .env and fill in. Never commit .env.

# --- Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=*

# --- Encryption key for MD private tasks (generate once; losing it makes private tasks unreadable)
FIELD_ENCRYPTION_KEY=

# --- Database: set DB_PASSWORD to use local PostgreSQL (database "jarvis"), otherwise SQLite is used
DB_NAME=jarvis
DB_USER=jarvis
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- AI brain (Claude)
ANTHROPIC_API_KEY=
JARVIS_AI_COMMAND_MODEL=claude-haiku-5-5
JARVIS_AI_BRIEFING_MODEL=claude-sonnet-5-5

# --- TaskPanel (live panel at public_html/taskPanel, reached through /taskPanel/integration/v1)
# mock = built-in test double with the same contract; live = the real TaskPanel
TASKPANEL_MODE=mock
TASKPANEL_BASE_URL=
TASKPANEL_KEY_ID=
TASKPANEL_SIGNING_SECRET=
TASKPANEL_ENV=production
TASKPANEL_EXPECTED_INSTANCE=
# Writes default to ON in mock mode and OFF in live mode. In live mode set true only for the pilot.
# TASKPANEL_WRITES_ENABLED=false
TASKPANEL_DEFAULT_CATEGORY=general
