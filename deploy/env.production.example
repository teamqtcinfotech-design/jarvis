# Copy to /srv/jarvis/backend/.env on the VPS and fill in. Never commit the real file.
# Generate secrets ON THE SERVER (commands are in deploy/VPS-SETUP.md).

# --- Django (production)
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=jarvis.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://jarvis.example.com
DJANGO_BEHIND_HTTPS_PROXY=true

# --- Encryption key for MD private tasks. Back it up safely: losing it makes private tasks unreadable.
FIELD_ENCRYPTION_KEY=

# --- PostgreSQL (the NEW "jarvis" database only)
DB_NAME=jarvis
DB_USER=jarvis
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- AI brain (use a separate production key from the "Friday" workspace)
ANTHROPIC_API_KEY=
JARVIS_AI_COMMAND_MODEL=claude-haiku-5-5
JARVIS_AI_BRIEFING_MODEL=claude-sonnet-5-5

# --- Live push to the phones (Firebase Cloud Messaging). Copy the service-account key to the VPS, never into git:
#       scp firebase-admin.json root@VPS:/srv/jarvis/firebase.json
#     Without it, push is off and the phones use their half-minute check instead.
FIREBASE_SERVICE_ACCOUNT_FILE=/srv/jarvis/firebase.json

# --- TaskPanel: mock until the access door is installed on TaskPanel, then switch to live
TASKPANEL_MODE=mock
TASKPANEL_BASE_URL=
TASKPANEL_KEY_ID=
TASKPANEL_SIGNING_SECRET=
TASKPANEL_ENV=production
TASKPANEL_EXPECTED_INSTANCE=
# TASKPANEL_WRITES_ENABLED=false

# --- Port for gunicorn (must be free on this server; nginx proxies to it)
JARVIS_PORT=8010
